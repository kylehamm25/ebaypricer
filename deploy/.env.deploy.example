# Copy this file to deploy/.env.deploy, fill in real values, then run:
#   source deploy/.env.deploy && ./deploy/deploy.sh

export AWS_ACCOUNT_ID="123456789012"
export AWS_REGION="us-east-1"
export ECS_CLUSTER="ebaypricer-cluster"
export ECS_SERVICE="ebaypricer-service"

# Frontend build args (baked into the JS bundle at image-build time)
export VITE_SUPABASE_URL="https://<ref>.supabase.co"
export VITE_SUPABASE_ANON_KEY="<anon_key>"

# Backend runtime env (non-secret - secrets live in Secrets Manager, see README)
export SUPABASE_URL="https://<ref>.supabase.co"
export SUPABASE_ANON_KEY="<anon_key>"
export DEFAULT_USER_ID="00000000-0000-0000-0000-000000000000"
export ALLOWED_ORIGINS="https://your.domain.com"
