EBAY_APP_ID="your_app_id"
EBAY_SECRET="your_app_secret"
EBAY_DEV_ID="your_dev_id"
RUNAME="your_ru_name"
ACCESS_TOKEN="your_access_token"
REFRESH_TOKEN="your_refresh_token"

# Supabase (Phase 1+)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="your_anon_key"
SUPABASE_SERVICE_KEY="your_service_role_key"
SUPABASE_JWT_SECRET="your_jwt_secret"
DEFAULT_USER_ID="00000000-0000-0000-0000-000000000000"

# Phase 4 - single host deployment
# Set to 1/true to require Supabase JWT auth (401 without token). Defaults to true.
# Set to "false" for local dev without a Supabase login (falls back to DEFAULT_USER_ID below).
AUTH_REQUIRED="true"
# Path to built frontend (defaults to dashboard/frontend/dist)
# FRONTEND_DIST="/app/dashboard/frontend/dist"
# Comma-separated CORS origins (defaults to localhost:5173 dev servers)
# ALLOWED_ORIGINS="https://your.domain.com"

# Phase 5 - per-user eBay OAuth
# Fernet key used to encrypt eBay refresh tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# EBAY_TOKEN_ENCRYPTION_KEY="..."
# eBay scopes granted to the app (space-separated). Defaults to
# sell.fulfillment.readonly + sell.inventory.readonly. Add
# sell.finances.readonly once approved in the eBay developer portal.
# EBAY_SCOPES="https://api.ebay.com/oauth/api_scope/sell.fulfillment.readonly https://api.ebay.com/oauth/api_scope/sell.inventory.readonly"

# Phase 6 - per-user eBay sync
# Fetch window in days (overlap lets fees/earnings update for recent orders)
# EBAY_SYNC_DAYS="120"
# How often the background scheduler syncs connected users (hours)
# EBAY_SYNC_INTERVAL_HOURS="6"

# Phase 7 - legacy pipeline runner
# How often the app runs scripts/main.py and ingests workbook + SQLite results (hours)
# EBAY_PIPELINE_INTERVAL_HOURS="1"

# Shared marketplace price research (Phase 3)
# How often the app researches every card any connected user has listed and
# updates each user's active_listings derived pricing columns (hours)
# EBAY_PRICE_RESEARCH_INTERVAL_HOURS="6"

# Per-user promotion ad-rate boosting (Phase 4). Requires the sell.marketing
# scope (see EBAY_SCOPES above) and Promoted Listings eligibility - accounts
# without it are skipped per-user, not treated as a failure.
# EBAY_PROMOTION_INTERVAL_HOURS="24"
